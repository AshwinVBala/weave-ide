}

style TodoHeader {
    fontSize: 24;
    fontWeight: "bold";
    color: "#1e293b";
}

style ContainerStyle {
    padding: 24;
    gap: 16;
}

component TodoApp() {
    var newTodoText: String = "";

    VStack(style: ContainerStyle) {
        Text("My Todo List", style: TodoHeader);

        HStack {
            TextField(value: newTodoText, placeholder: "Add a new task...");
            Button("Add", onClick: () -> {
                newTodoText = "";
            });
        }

        VStack {
            Text("No tasks yet!");
        }
    }
}
